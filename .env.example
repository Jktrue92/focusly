# Supabase Dashboard → Project Settings → API. Public client credentials only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical deployment origin for password-reset emails; no trailing path.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
# Public privacy contact, monitored by the operator. Required before public launch.
NEXT_PUBLIC_PRIVACY_EMAIL=hellofocusly@gmail.com
NEXT_PUBLIC_OPERATOR_NAME=Focusly Inc.
